{
  "name": "amazon-ops-pilot",
  "version": "1.0.0",
  "private": true,
  "description": "以运营主技能管理亚马逊全流程，通过 MCP 和 SP-API 执行受控上架。",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build && node --watch --env-file-if-exists=.env dist/server.js",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "demo": "node dist/cli.js demo",
    "test": "node --test --test-reporter=spec .test-dist/tests/*.test.js",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "lint": "eslint src tests scripts",
    "check": "npm run lint && npm test && npm run skills:check",
    "skills:check": "node scripts/check-skills.mjs",
    "skill:install": "node scripts/install-skill.mjs"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
